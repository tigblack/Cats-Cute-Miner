{
  "purpose": "Examples of Devour event shapes. Values are synthetic; never send examples as production revenue.",
  "examples": [
    {"name": "game_loaded", "payload": {}},
    {"name": "rewarded", "payload": {"loaded": ""}},
    {"name": "rewarded", "payload": {"displayed": "afk_double_reward"}},
    {"name": "rewarded", "payload": {"watched": "afk_double_reward"}},
    {"name": "rewarded_paid", "payload": {"days_since_install": 1, "playtime_minutes": 12, "last_opened_island": 2}},
    {"name": "ad_revenue", "payload": {"days_since_install": 1, "playtime_minutes": 12, "last_opened_island": 2, "total_impressions": 4, "total_revenue": 0.04, "total_ecpm": 10.0, "revenue": 0.01, "density": 0.0, "ad_type": "rewarded"}},
    {"name": "banner", "payload": {"displayed": "main_hud"}},
    {"name": "purchase", "payload": {"days_since_install": 1, "playtime_minutes": 12, "last_opened_island": 2, "key": "approved_product_id", "transaction_id": "synthetic_contract_transaction", "product_id": "approved_product_id"}},
    {"name": "playtime_event", "payload": {"playTime": 12}},
    {"name": "playtime_seconds_event", "payload": {"seconds": 720}}
